# ============================================================================
#  Copy this file to config.env, then fill in every value below.
#  Step-by-step instructions for each one: docs/getting-your-tokens.md
#
#  config.env is only ever read on your own Mac. It is listed in .gitignore
#  so it can never be committed or pushed to GitHub by accident.
# ============================================================================

# ── Your identity ──────────────────────────────────────────────────────────
# Your Slack member ID. docs/getting-your-tokens.md → "4. Your own Slack member ID"
SLACK_USER_ID=

# The email address you log into Jira with.
JIRA_EMAIL=

# docs/getting-your-tokens.md → "1. Jira API token"
JIRA_API_TOKEN=

# docs/getting-your-tokens.md → "2. Backlog API key"
BACKLOG_API_KEY=

# docs/getting-your-tokens.md → "3. Slack bot token + Team ID"
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=

# ── Whose Backlog tickets you want to watch (optional) ─────────────────────
# Leave both blank if you only want your own Jira tickets.
# Otherwise run bin/find-backlog-ids.sh "Name1" "Name2" after your first
# successful install to get the numeric IDs below.
# Example: BACKLOG_WATCH_USER_IDS=605331,581028,605846
#          BACKLOG_WATCH_NAMES=Faisal,Pravin,Makoto
BACKLOG_WATCH_USER_IDS=
BACKLOG_WATCH_NAMES=

# ── Office-wide settings (same for everyone — leave as-is unless told otherwise) ──
JIRA_URL=https://faisalashfaq.atlassian.net
BACKLOG_DOMAIN=jins.backlog.jp

# ── When the automatic summary is allowed to fire ───────────────────────────
# 24-hour clock, your Mac's local time, weekdays only. It fires once, the
# first time you're at your unlocked laptop inside this window.
WINDOW_START_HOUR=9
WINDOW_END_HOUR=12
