<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>{{JOB_LABEL}}</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string><string>-l</string>
    <string>{{REPO_DIR}}/bin/run.sh</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>180</integer>
  <key>StandardOutPath</key><string>{{HOME}}/Library/Logs/daily-ticket-summary.log</string>
  <key>StandardErrorPath</key><string>{{HOME}}/Library/Logs/daily-ticket-summary.log</string>
</dict>
</plist>
